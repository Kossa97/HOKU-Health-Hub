{
  "regions": ["dub1"],
  "crons": [
    {
      "path": "/api/send-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/hoku-anstoss",
      "schedule": "0 2 * * *"
    }
  ],
  "routes": [
    { "src": "/.well-known/apple-app-site-association", "headers": { "Content-Type": "application/json" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
