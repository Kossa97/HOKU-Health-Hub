/* Texte für die Erlaubnisabfragen von iOS (Deutsch). Englisch in en.lproj. */
"NSCameraUsageDescription" = "HOKU nutzt die Kamera zum Scannen von Barcodes auf Lebensmitteln und Produkten sowie – nach deiner Einwilligung – zum Fotografieren von Etiketten, die zum Auslesen übertragen werden. Es werden keine Bilder gespeichert.";
"NSMicrophoneUsageDescription" = "Hoku hört zu, wenn du im Chat auf das Mikrofon tippst, und HOKU hört zu, solange du im Training das Mikrofon hältst; das Gesagte wird zu Text. Es wird nichts aufgenommen oder gespeichert.";
"NSSpeechRecognitionUsageDescription" = "Die Spracherkennung von Apple wandelt das, was du Hoku im Chat sagst, und deine Sätze im Training (z. B. „80 Kilo, 8 Wiederholungen“) in Text um. HOKU speichert keine Aufnahmen.";
"NSHealthShareUsageDescription" = "HOKU liest Gesundheitsdaten, um Gewicht, Schritte, Schlaf, Herzfrequenz, Ruhepuls, Workouts und aktive Energie in deiner Dokumentation, im Training und im Kalorientracker anzuzeigen.";
"NSHealthUpdateUsageDescription" = "HOKU kann ausgewählte Gesundheitsdaten speichern, wenn du diese Funktion aktiv nutzt.";
