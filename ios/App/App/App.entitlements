<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: geteilte Profile /u/<name> (Profil 2c) und der Knopf „In Hoku öffnen“ in den Mails (docs/registrierung/APP-LINKS.md) -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:hokuhealth.app</string>
	</array>
</dict>
</plist>
