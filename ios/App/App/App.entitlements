<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: der Knopf „In Hoku öffnen“ in den Mails öffnet die App (docs/registrierung/APP-LINKS.md) -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:hokuhealth.app</string>
	</array>
	<!-- Apple Health lesen (src/lib/health.ts, Plugin @perfood/capacitor-healthkit) -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
</dict>
</plist>
