{
  "name": "peptid-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx --tsconfig tsconfig.app.json scripts/prerender-peptipedia.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:typecheck": "tsc -p e2e/tsconfig.json --noEmit",
    "seed:pk": "tsx scripts/seed-pk-profiles.ts",
    "seed:test": "tsx scripts/seed-test-data.ts",
    "faq:export": "tsx scripts/export-faq-en.ts",
    "faq:generate": "node scripts/generate-faq-locales.mjs",
    "i18n:onboarding:merge": "node scripts/merge-onboarding-i18n.mjs",
    "i18n:onboarding:generate": "node scripts/generate-onboarding-i18n.mjs",
    "catalog:sql": "node scripts/generate-substance-catalog-sql.mjs",
    "pk:sql": "node scripts/generate-pk-profiles-sql.mjs",
    "pk:routes-sql": "node scripts/generate-pk-profile-routes-sql.mjs",
    "effects:duration:sql": "node scripts/generate-effect-duration-sql.mjs",
    "peptipedia:audit": "tsx --tsconfig tsconfig.app.json scripts/audit-peptipedia.ts",
    "model:optimize": "node scripts/optimize-torso-model.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.4",
    "@perfood/capacitor-healthkit": "^1.3.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@sentry/react": "^11.1.0",
    "@supabase/supabase-js": "^2.105.4",
    "@types/three": "^0.184.1",
    "barcode-detector": "3.2.2",
    "capacitor-health-connect": "^0.7.0",
    "date-fns": "^4.1.0",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^1.14.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.8",
    "react-is": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "three": "^0.184.0",
    "web-push": "^3.6.7",
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitalets/google-translate-api": "^9.2.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  }
}
