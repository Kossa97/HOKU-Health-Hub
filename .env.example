# Fehler-Monitoring (Sentry). Leer lassen = aus.
# In Vercel als Umgebungsvariable für Production (und ggf. Preview) setzen.
VITE_SENTRY_DSN=

# Anmelden mit Apple / Google (Supabase-OAuth). 1 = Knopf im Login zeigen.
# Erst setzen, wenn der Anbieter in Supabase eingerichtet ist: docs/login/ANBIETER.md
VITE_AUTH_APPLE=
VITE_AUTH_GOOGLE=

# Face ID / Passkeys (Supabase, experimentell). 1 = Knopf, Nachfrage und Profil-Eintrag zeigen.
# Erst setzen, wenn Passkeys in Supabase eingerichtet sind: docs/login/PASSKEYS.md
VITE_AUTH_PASSKEY=
